# Copy to .env and fill in the first two. Everything else is commented out
# at its default; uncomment a line to override it.

# Required: the database password, used by the container and the app.
NEO4J_PASSWORD=
# Required for chat and `rules-lawyer embed` with the default provider,
# Google. Leave blank for the keyless path.
GOOGLE_API_KEY=

# Other providers. Each needs its package: `uv sync --extra <provider>` in
# backend/ (or `--all-extras`).
# OPENAI_API_KEY=
# An OpenAI-compatible server instead of OpenAI (LM Studio, vLLM, OpenRouter).
# OPENAI_BASE_URL=http://localhost:1234/v1
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
# From the Docker image, Ollama on this machine is:
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# An embeddings file to use instead of generating one.
# RULES_LAWYER_EMBEDDINGS=data/output/srd_embeddings.idx

# Where `docker compose up` serves the app.
# RULES_LAWYER_PORT=8080

# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_DATABASE=neo4j

# Who answers: google, openai, anthropic or ollama. Any but google needs
# CHAT_MODEL set too. With ollama, pick a model that supports tool calling
# (qwen3, llama3.1).
# CHAT_PROVIDER=google
# CHAT_MODEL=gemini-3.8-flash
# Deprecated for Google, OpenAI and Anthropic models, so unset sends them
# none; Ollama gets 0.2.
# CHAT_TEMPERATURE=
# CHAT_MAX_TOKENS=
# How long the model may stay silent before a turn fails.
# CHAT_TIMEOUT_SECONDS=60
# Lookups one question may make before the model must answer.
# CHAT_MAX_TOOL_CALLS=8

# Who embeds: google, openai or ollama (Anthropic has no embeddings). Any but
# google needs EMBED_MODEL, keeps its own srd_embeddings.<provider>.idx, and
# needs `rules-lawyer embed` and `load` after switching.
# EMBED_PROVIDER=google
# EMBED_MODEL=gemini-embedding-001
# Changing it means regenerating the embeddings. It must be the model's own
# width unless the model can be truncated (Gemini, OpenAI's text-embedding-3).
# EMBED_DIMENSIONS=1536
# Put before every section and every question, for a model whose card asks
# for a pair. Quote a value to keep its trailing space. Changing the document
# prefix re-embeds every section.
# EMBED_DOCUMENT_PREFIX=
# EMBED_QUERY_PREFIX=
